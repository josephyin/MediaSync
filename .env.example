SECRET_KEY=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-another-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# 局域网 HTTP 保持 false；HTTPS 反向代理部署改为 true。
SESSION_COOKIE_SECURE=false
MEDIASYNC_HTTP_PORT=9090

# 使用官方预构建镜像时取消下面两行注释；本地源码构建可保持注释。
# MEDIASYNC_IMAGE=ghcr.io/josephyin/mediasync
# MEDIASYNC_IMAGE_TAG=v0.2.0-rc.3

# 本地兼容模式默认值。官方 Compose 拓扑会为所有后端服务覆盖为 process。
BACKGROUND_EXECUTION_MODE=legacy

# 实验性的 Web 私有接口模式（默认）。上游变化可能导致其随时失效。
ALIYUNDRIVE_MODE=private_api
ALIYUNDRIVE_PRIVATE_API_BASE_URL=https://api.alipan.com
ALIYUNDRIVE_PRIVATE_AUTH_BASE_URL=https://auth.alipan.com
ALIYUNDRIVE_QR_LOGIN_BASE_URL=https://passport.aliyundrive.com

# 私有接口请求保护。除非明确了解风险，否则请保留保守的默认值。
ALIYUNDRIVE_REQUEST_INTERVAL_SECONDS=0.8
ALIYUNDRIVE_REQUEST_JITTER_SECONDS=0.3
ALIYUNDRIVE_REQUEST_MAX_RETRIES=3
ALIYUNDRIVE_RETRY_BACKOFF_SECONDS=2
ALIYUNDRIVE_RETRY_MAX_SECONDS=30
SCHEDULER_JITTER_SECONDS=120
MANUAL_SCAN_COOLDOWN_SECONDS=60
FOLDER_SCAN_BATCH_SIZE=20
FULL_SCAN_INTERVAL_HOURS=24
TRANSFER_BATCH_SIZE=2
TRANSFER_RETRY_BASE_SECONDS=30
TRANSFER_RETRY_MAX_SECONDS=900

# Task Engine v2 Scheduler 进程。
SCHEDULER_POLL_SECONDS=10
SCHEDULER_BATCH_SIZE=100

# Task Engine v2 Worker 进程。官方 SQLite 拓扑只支持一个 Worker，并发度为 1。
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
WORKER_RECOVERY_BATCH_SIZE=100
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=900

# 官方模式：设置 ALIYUNDRIVE_MODE=official，并创建审核通过的开放平台应用。
ALIYUNDRIVE_CLIENT_ID=
ALIYUNDRIVE_CLIENT_SECRET=
ALIYUNDRIVE_API_BASE_URL=https://openapi.alipan.com
